<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZKBanAndroid"
        tools:replace="android:theme"
        tools:targetApi="31">
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ProverActivity"
            android:exported="true"
            android:label="@string/title_activity_prover"
            android:theme="@style/Theme.ZKBanAndroid">
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="zk-ban"
                    android:scheme="zk-ban" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.akakou.proverkit.identification.phone_auth.PhoneNumberAuthActivity"
            android:exported="true"
            android:label="@string/title_activity_phone_auth"
            android:theme="@style/Theme.ProverKit" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ZKBanAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.akakou.proverkit.CredentialViewActivity"
            android:exported="false"
            android:label="@string/title_activity_credential_view"
            android:theme="@style/Theme.ProverKit" />
    </application>

</manifest>